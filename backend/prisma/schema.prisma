// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INSTRUCTOR
  STUDENT
  ADMIN
}

model User {
  id                       Int           @id @default(autoincrement())
  name                     String
  email                    String        @unique
  password                 String
  role                     Role
  isActive                 Boolean       @default(true)
  authVersion              Int           @default(0)
  passwordResetTokenHash   String?       @unique
  passwordResetExpiresAt   DateTime?
  passwordResetRequestedAt DateTime?
  createdAt                DateTime      @default(now())
  courses                  Course[] // các khóa học mình dạy (nếu là INSTRUCTOR)
  enrollments              Enrollment[] // các khóa học mình đã tham gia (nếu là STUDENT)
  chatMessages             ChatMessage[] // lịch sử chat với AI
  lessonProgress           LessonProgress[]
  submissions              AssignmentSubmission[]
  quizAttempts             QuizAttempt[]
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String
  description  String       @default("") @db.Text
  joinCode     String       @unique // mã mời để sinh viên tham gia
  instructorId Int
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lessons      Lesson[]
  enrollments  Enrollment[]
  assignments  Assignment[]
}

// Bảng trung gian thể hiện quan hệ nhiều-nhiều: 1 student tham gia nhiều course, 1 course có nhiều student
model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // 1 user không thể enroll trùng 1 course 2 lần
}

model Lesson {
  id            Int           @id @default(autoincrement())
  title         String
  content       String?       @db.Text
  documentUrl   String? // tên file PDF/text được lưu cục bộ
  documentName  String?
  extractedText String?       @db.Text // nội dung trích xuất từ file, dùng làm context cho AI
  order         Int           @default(0)
  courseId      Int
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  chatMessages  ChatMessage[]
  progress      LessonProgress[]
  quizAttempts  QuizAttempt[]
}

model Assignment {
  id          Int                    @id @default(autoincrement())
  title       String
  description String                 @db.Text
  dueAt       DateTime?
  points      Int                    @default(100)
  courseId    Int
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model AssignmentSubmission {
  id          Int        @id @default(autoincrement())
  content     String     @db.Text
  submittedAt DateTime   @default(now())
  grade       Int?
  feedback    String?    @db.Text
  assignmentId Int
  studentId   Int
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model QuizAttempt {
  id              Int       @id @default(autoincrement())
  questions       Json
  draftAnswers    Json      @default("[]")
  selectedAnswers Json?
  version         Int       @default(0)
  score           Int?
  submittedAt     DateTime?
  userId          Int
  lessonId        Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([userId, lessonId, createdAt])
}

model LessonProgress {
  userId      Int
  lessonId    Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
