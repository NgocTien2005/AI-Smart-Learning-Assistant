# Reference only: enter these privately in Render backend Environment.
# Never upload this file with real values or put secrets in VITE_*.
NODE_ENV=production
DATABASE_URL=
# Same new Supabase session pooler target; Prisma CLI TLS parameters differ.
MIGRATION_DATABASE_URL=
JWT_SECRET=
APP_ORIGIN=https://YOUR-FRONTEND.onrender.com
CORS_ORIGIN=https://YOUR-FRONTEND.onrender.com
DOCUMENT_STORAGE=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_STORAGE_BUCKET=lumina-documents
SUPABASE_STORAGE_KEY=
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=
BREVO_SENDER_VERIFIED=false
LUMINA_DEMO_ALLOWED=false
GEMINI_API_KEY=
GEMINI_FREE_ONLY_CONFIRMED=false
GEMINI_CHAT_ALLOWED=false
# Frontend service ONLY: VITE_API_URL=https://YOUR-BACKEND.onrender.com
# Never add ADMIN_BOOTSTRAP_* to the public frontend or backend service.
