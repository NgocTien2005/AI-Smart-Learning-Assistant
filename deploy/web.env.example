# Copy to ignored .env.web on a fresh VPS; chmod600. Never upload that file.
# Hostname only, no https://, path or wildcard. Replace the example.
LUMINA_DOMAIN=lms.example.com
# Generate independent strong hexadecimal values privately (see guide).
POSTGRES_PASSWORD=
JWT_SECRET=
# Optional SMTP, entered privately. No sender/recipient guessed or sent by setup.
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional Gemini: confirm billing DISABLED and Free privacy terms first.
GEMINI_API_KEY=
GEMINI_FREE_ONLY_CONFIRMED=false
GEMINI_CHAT_ALLOWED=false
# Temporary admin bootstrap: remove all three after creating the first admin.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
